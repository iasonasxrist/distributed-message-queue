# Cluster settings. docker-compose passes this file to every service.
# Change a value, then run: docker compose up -d
#
# Retention can also be changed while the cluster runs, from the console
# (http://localhost:8080). A value set there wins over RETENTION_HOURS.

# --- Log management -----------------------------------------------------------
# How long messages are kept, in hours (720 = 30 days, 0 = forever).
RETENTION_HOURS=720
# A partition starts a new segment file every this many messages. Old messages
# are deleted one whole segment at a time, so smaller segments purge more precisely.
SEGMENT_MAX_MESSAGES=1000
# How often each broker looks for expired segments, in seconds.
RETENTION_CHECK_SECONDS=60

# --- Confirming writes --------------------------------------------------------
# When a write is confirmed to the sender, for topics without their own setting:
#   all       after every follower has it (safest)
#   majority  after a majority of the replicas have it (survives one broker failing)
#   leader    after the leader alone has it (fastest; a confirmed message can be lost)
# A topic's own setting is changed in the console under "Topic settings".
DEFAULT_ACKS=all
# Most messages the leader sends to a follower in one request.
REPLICATION_BATCH_MESSAGES=500

# --- Failover -----------------------------------------------------------------
# Seconds of silence after which a broker is declared dead and its partitions get
# a new leader. Lower is faster but risks false alarms. ZooKeeper does not go
# below twice its tickTime (4 seconds with the default configuration).
ZOOKEEPER_SESSION_TIMEOUT=4
# How often a broker checks whether it should rejoin a partition, in seconds
# (for example because the leader it could not reach at startup is back).
REJOIN_CHECK_SECONDS=10
# How long the producer keeps retrying a write while a partition changes leader,
# in seconds (0 = answer 503 at once).
PRODUCER_RETRY_SECONDS=15

# --- Sign-in ------------------------------------------------------------------
# 1: the producer, consumer and console ask for a username and password.
# 0: everything is open.
AUTH_ENABLED=1
# The administrator created on the very first start. Sign in with it, then change
# the password in the console (or POST /change_password on port 7000). Changing
# these two lines later has no effect once the user exists.
AUTH_DEFAULT_USER=admin
AUTH_DEFAULT_PASSWORD=admin
# How long a sign-in token stays valid, in hours.
AUTH_TOKEN_HOURS=12
# Secret shared by the cluster's own services. Brokers refuse requests without
# it, so nobody can go around the sign-in by calling a broker directly.
# Replace it with your own random text before exposing the system to anyone.
INTERNAL_TOKEN=change-me-to-a-long-random-value

# --- Console ------------------------------------------------------------------
# Set to 1 to hide the retention and purge controls.
CONSOLE_READ_ONLY=0
