# Switches read by docker compose itself (settings for the services are in settings.env).
# After changing a value run:  docker compose up --build -d

# Which broker runs. All brokers use the same one.
#   ./broker     the Python broker (default)
#   ./broker-go  the same broker written in Go
# To roll back, set it to ./broker again. Brokers are rebuilt when this changes,
# so messages stored inside the old containers are not carried over.
BROKER_BUILD=./broker

# Which producer runs.
#   empty  only the Python producer, on PRODUCER_PORT
#   go     also start the Go producer, on PRODUCER_GO_PORT, to compare the two
COMPOSE_PROFILES=

# Ports on this machine. To make the Go producer the main one, set
# COMPOSE_PROFILES=go and swap the two numbers; swap them back to roll back.
PRODUCER_PORT=4000
PRODUCER_GO_PORT=4001
